# =============================================================================
# Yu-Gi-Oh! Platform Master Environment Configuration Template (.env.example)
# =============================================================================
# Copy this file to '.env' and populate with your live credentials:
#     cp .env.example .env
#
# Sections:
# 1. Platform Runtime Environment & Logging
# 2. Public Domains, Networking & Web Catalog Endpoints
# 3. Live Duel Simulator (ocgcore Engine & Docker Stack)
# 4. The Great Kasutamaiza - Modular Discord Story & Duel Bot
# 5. Cloudflare Zero Trust Named Tunnel (HTTPS & DDoS Mitigation)
# 6. Dynamic DNS Auto-Updater (DuckDNS)
# 7. Database Engine & Shared Storage Paths
# 8. Future Upgrades & Card Ingestion Pipeline Placeholders
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Platform Runtime Environment & Logging
# -----------------------------------------------------------------------------
# Operating mode: 'production' for live servers, 'development' for local staging
ENVIRONMENT="production"

# Application logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# -----------------------------------------------------------------------------
# 2. Public Domains, Networking & Web Catalog Endpoints
# -----------------------------------------------------------------------------
# Primary public domain (Cloudflare DNS managed)
PUBLIC_DOMAIN="yourdomain.com"

# Dynamic DNS fallback domain (used if public IP rotates)
PUBLIC_FALLBACK_DOMAIN="yoursubdomain.duckdns.org"

# Public API base URL advertised to remote game clients for card synchronization
PUBLIC_API_URL="https://yourdomain.com"

# Local network interfaces for FastAPI web catalog and REST API
WEB_HOST="0.0.0.0"
WEB_PORT="8000"

# Permitted CORS origins for Web API (comma-separated or '*' for public access)
CORS_ORIGINS="*"

# -----------------------------------------------------------------------------
# 3. Live Duel Simulator (ocgcore Engine & Docker Stack)
# -----------------------------------------------------------------------------
# Hostname or IP where players connect via EDOPro / Project Ignis / YGOPro
# NOTE: Must resolve directly to the server (Raw TCP, not HTTP Cloudflare proxied)
SIMULATOR_HOST="yourdomain.com"
SIMULATOR_FALLBACK_HOST="YOUR_SERVER_PUBLIC_IP"

# Primary game client socket port (Raw TCP duel protocol)
SIMULATOR_PORT="7911"

# Web Room Manager & spectator dashboard port (HTTP/WebSocket)
SIMULATOR_ROOM_PORT="7922"

# Docker container and repository settings
DOCKER_USERNAME="professorseanex"
DOCKER_IMAGE="professorseanex/ygoserver:latest"
DOCKER_CONTAINER_NAME="ygo-simulator-server"

# -----------------------------------------------------------------------------
# 4. The Great Kasutamaiza - Modular Discord Story & Duel Bot
# -----------------------------------------------------------------------------
# Discord Developer Application Bot Token (Requires Message Content Intent)
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# Target Discord Guild / Server ID for instant slash command registration
DISCORD_GUILD_ID="your_guild_id_here"

# Application Client ID (The Great Kasutamaiza)
DISCORD_CLIENT_ID="your_client_id_here"

# Legacy text prefix for non-slash administrative fallback commands
DISCORD_COMMAND_PREFIX="!"

# -----------------------------------------------------------------------------
# 5. Cloudflare Zero Trust Named Tunnel (HTTPS & DDoS Mitigation)
# -----------------------------------------------------------------------------
# Official tunnel authentication token from Cloudflare Zero Trust dashboard
CLOUDFLARE_TUNNEL_TOKEN="your_cloudflare_tunnel_token_here"

# Named tunnel identifier
CLOUDFLARE_TUNNEL_ID="your_tunnel_id_uuid_here"
CLOUDFLARE_TUNNEL_NAME="ygo-server-tunnel"

# -----------------------------------------------------------------------------
# 6. Dynamic DNS Auto-Updater (DuckDNS)
# -----------------------------------------------------------------------------
# DuckDNS subdomain identifier: <subdomain>.duckdns.org
DUCKDNS_DOMAIN="yoursubdomain"

# Account API Token from https://www.duckdns.org
DUCKDNS_TOKEN="your_duckdns_token_here"

# -----------------------------------------------------------------------------
# 7. Database Engine & Shared Storage Paths
# -----------------------------------------------------------------------------
# Relational SQLite story database containing custom cards, factions, and lore
DATABASE_PATH="production/main/web/ygo_story.db"

# Compiled binary SQLite card database distributed to game clients
CDB_OUTPUT_PATH="production/shared/expansions/custom_cards.cdb"

# Directory where generated ocgcore Lua effect scripts reside
SCRIPTS_DIR="production/shared/expansions/scripts"

# Directory containing character and player .ydk decklists
DECKS_DIR="production/shared/decks"

# -----------------------------------------------------------------------------
# 8. Future Upgrades & Card Ingestion Pipeline Placeholders
# -----------------------------------------------------------------------------
# These settings prepare the platform for future Duelingbook card ingestion,
# automated artwork caching, and API token authentication.

# Upstream card workshop endpoint
DUELINGBOOK_API_ENDPOINT="https://www.duelingbook.com"

# Local directory for cached high-resolution card artwork thumbnails
CARD_ART_CACHE_DIR="production/main/assets/cache"

# Automated card expansion background sync interval in minutes
AUTO_SYNC_INTERVAL_MINUTES="15"

# Cryptographic secret for signing future JWT session tokens or admin API routes
API_SECRET_KEY="generate-secure-random-key-for-future-admin-auth"
