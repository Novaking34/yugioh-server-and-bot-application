# =============================================================================
# Systemd Service Unit: Yu-Gi-Oh! Web Catalog Dashboard & REST API
# =============================================================================
# Manages the 24/7 FastAPI Uvicorn application:
# - Serves interactive custom card catalog and archetype browser (Port 8000)
# - Provides expansion download endpoints (/api/shared/cdb, /api/shared/manifest)
# - Reads from primary SQLite database (production/main/web/ygo_story.db)
# =============================================================================

[Unit]
Description=Yu-Gi-Oh! Web Catalog Dashboard & REST API
After=network.target

[Service]
Type=simple
User=professorseanex
WorkingDirectory=/home/professorseanex/yugioh-server
ExecStart=/home/professorseanex/yugioh-server/venv/bin/uvicorn production.main.web.api_server:app --app-dir /home/professorseanex/yugioh-server --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/professorseanex/yugioh-server/.env

[Install]
WantedBy=multi-user.target
