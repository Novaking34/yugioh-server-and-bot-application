# =============================================================================
# Systemd Service Unit: Yu-Gi-Oh! Live Duel Simulator Container (ocgcore)
# =============================================================================
# Manages the 24/7 lifecycle of the Docker Compose simulator container:
# - Binds TCP 7911 (raw game client duel socket)
# - Binds TCP 7922 (room manager dashboard & websocket)
# - Auto-starts on boot after Docker daemon is ready
# =============================================================================

[Unit]
Description=Yu-Gi-Oh! Live Duel Simulator Container (ocgcore)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/professorseanex/yugioh-server
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
