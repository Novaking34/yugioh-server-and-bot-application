# =============================================================================
# BLOCK 1: METADATA BLOCK
# =============================================================================
# Module: .gitignore
# Architecture: Git Version Control Exclusion Rules
# Domain: Repository Cleanliness, Artifact Exclusion & Secret Protection
# Description: Authoritative specification of files, patterns, and directories
#              prohibited from git version control:
#              - Python bytecode and compiled C extensions
#              - Virtual environments and package build directories
#              - Release distribution archives in dist/
#              - Environment files, credentials, and sensitive tokens
#              - Operating system metadata and IDE workspace configs
#              - Runtime log files and large binary duel replays (.yrp)
#
# Invariants:
#   - STRICT SECRECY: Never permit .env or credentials to be tracked.
#   - REPRODUCIBILITY: Only source code and canonical assets are committed.
# =============================================================================

# =============================================================================
# BLOCK 2: OPENING BLOCK (Runtimes, Compilers & Bytecode Caches)
# =============================================================================
__pycache__/
/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# =============================================================================
# BLOCK 3: BODY BLOCK (Virtual Environments, Builds, Testing & Secrets)
# =============================================================================

# -----------------------------------------------------------------------------
# SUB-BLOCK 3.1: Python Virtual Environments
# -----------------------------------------------------------------------------
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# -----------------------------------------------------------------------------
# SUB-BLOCK 3.2: Package Builds, Distributions & Setuptools Artifacts
# -----------------------------------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.whl

# -----------------------------------------------------------------------------
# SUB-BLOCK 3.3: Automated Testing, Coverage & Linters
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# -----------------------------------------------------------------------------
# SUB-BLOCK 3.4: Secrets, Tokens & Environment Configurations
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.token
*.pem
*.key
discord_bot/config.json
production/main/discord_bot/config.json

# -----------------------------------------------------------------------------
# SUB-BLOCK 3.5: Operating System & Editor Metadata
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# =============================================================================
# BLOCK 4: CLOSING BLOCK (Runtime Server Logs & Match Replays)
# =============================================================================
*.log
logs/
data/simulator/replays/*.yrp
!data/simulator/replays/.gitkeep
