# =============================================================================
# Yu-Gi-Oh! Platform - Git Ignore Rules
# =============================================================================
# Protects repository integrity by excluding:
# - Python bytecode and compiled C extensions
# - Virtual environments and package build directories
# - Release archives in dist/
# - Environment files, Discord bot tokens, and sensitive secrets
# - OS-specific metadata and IDE workspace settings
# - Runtime log files and large binary duel replays (.yrp)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Python Bytecode, Caching & Compiled Binaries
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# -----------------------------------------------------------------------------
# 2. Package Builds, Distributions & Setuptools Artifacts
# -----------------------------------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.whl

# -----------------------------------------------------------------------------
# 3. Python Virtual Environments
# -----------------------------------------------------------------------------
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# -----------------------------------------------------------------------------
# 4. Automated Testing, Coverage & Linters
# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# -----------------------------------------------------------------------------
# 5. Secrets, Tokens & Environment Configurations
# -----------------------------------------------------------------------------
.env
.env.*
*.token
*.pem
*.key
discord_bot/config.json
production/main/discord_bot/config.json

# -----------------------------------------------------------------------------
# 6. Operating System & Editor Metadata
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
*.bak

# -----------------------------------------------------------------------------
# 7. Runtime Server Logs & Match Replays
# -----------------------------------------------------------------------------
*.log
logs/
production/main/simulator/replays/*.yrp
!production/main/simulator/replays/.gitkeep
